            "scope": "all_channels"
          },
          "severity": "P0"
        }
      },
      "termination_policy": {
        "tool": "end_call",
        "mode": "required",
        "allowed_reasons": [
          "optout_completed"
        ],
        "required_milestones": [
          "dnc_registered",
          "optout_confirmed"
        ],
