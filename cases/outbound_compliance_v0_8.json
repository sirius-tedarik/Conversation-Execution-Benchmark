        "end_call"
      ],
      "tool_sequence": [
        "register_do_not_call",
        "end_call"
      ]
    },
    "conversation": {
      "max_words_per_turn": 30,
      "max_questions_per_turn": 0,
      "required_assistant_regex": [
        "çıkar",
        "aranmayacaksınız"
      ]
    },
    "flow": {},
    "runtime": {
      "max_model_latency_ms": 8000
    },
    "perturbations": {
      "user_behavior": "do_not_call_request",
      "policy_risk": "marketing_compliance",
      "expected_outcome": "immediate_optout"
