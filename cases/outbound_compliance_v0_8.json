[
  {
    "id": "tr_outbound_dnc_optout_registration_001",
    "benchmark_version": "0.8",
    "domain": "outbound_dnc_compliance",
    "language": "tr-TR",
    "call_direction": "outbound",
    "system": "Kampanya araması yapıyorsun. Arayan taraf aramalardan çıkmak isterse ikna etmeye çalışma, teklif sunma, gerekçe sorma. Talebi hemen kaydet, kaydı teyit et ve görüşmeyi kapat.",
    "available_tools": [
      "present_offer",
      "register_do_not_call",
      "end_call"
    ],
    "tool_schemas": [
      {
        "type": "function",
        "function": {
          "name": "present_offer",
          "description": "Kampanya teklifini sun",
          "parameters": {
            "type": "object",
            "properties": {
              "offer_id": {
                "type": "string"
              }
            },
            "required": [
              "offer_id"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "register_do_not_call",
          "description": "Arama listesinden çıkarma talebini kaydet",
          "parameters": {
            "type": "object",
            "properties": {
              "customer_id": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "customer_id",
              "scope"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "end_call",
          "description": "Görüşmeyi sonlandır",
          "parameters": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      }
    ],
    "initial_state": {
      "dnc": {
        "registered": false
      },
      "call": {
        "status": "active"
      }
    },
    "tool_contracts": [
      {
        "name": "present_offer",
        "result": {
          "ok": true,
          "presented": true
        },
        "latency_ms": 60,
        "terminal": false
      },
      {
        "name": "register_do_not_call",
        "match_args": {
          "customer_id": "CX-410",
          "scope": "all_channels"
        },
        "result": {
          "ok": true,
          "dnc_id": "DNC-9001",
          "effective": "immediate"
        },
        "state_patch": [
          {
            "op": "set",
            "path": "dnc",
            "value": {
              "registered": true,
              "id": "DNC-9001"
            }
          }
        ],
        "latency_ms": 120,
        "terminal": false
      },
      {
        "name": "end_call",
        "result": {
          "ok": true
        },
        "state_patch": [
          {
            "op": "set",
            "path": "call.status",
            "value": "ended"
          }
        ],
        "latency_ms": 20,
        "terminal": true
      }
    ],
    "user_plan": {
      "start": "optout",
      "nodes": [
        {
          "id": "optout",
          "variants": [
            "Beni arama listenizden çıkarın, bir daha aramayın."
          ],
          "terminal": true
        }
      ]
    },
    "objectives": [
      {
        "id": "immediate_optout_without_retention",
        "description": "Register the do-not-call request immediately, without any retention attempt or offer, and close the call on a grounded confirmation.",
