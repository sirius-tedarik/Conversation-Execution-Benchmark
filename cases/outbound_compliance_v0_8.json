    "_mock_runs": [
      [
        "Talebinizi aldım, sizi arama listesinden çıkarıyorum.\n<tool_call>{\"name\":\"register_do_not_call\",\"arguments\":{\"customer_id\":\"CX-410\",\"scope\":\"all_channels\"}}</tool_call>",
        "Kaydınız alındı, bundan sonra aranmayacaksınız. İyi günler dilerim.\n<tool_call>{\"name\":\"end_call\",\"arguments\":{\"reason\":\"optout_completed\"}}</tool_call>"
      ]
    ],
    "metadata": {
      "source": "synthetic-controlled",
      "split": "public-outbound-compliance",
      "family": "dnc_optout"
    }
