[
  {
    "id":"tr_flow_nested_detour_rejoin_001","benchmark_version":"0.8","domain":"nested_detour_flow","language":"tr-TR","call_direction":"inbound",
    "system":"Poliçe yenileme akışını yürüt. Kullanıcı araya konu açarsa kısa cevap ver ve açılış sırasının tersine dön: önce bir önceki ara konuya, sonra ana akışa. Daha önce alınan bilgileri tekrar sorma.",
    "available_tools":["get_renewal_quote","renew_policy"],
