      {"id":"discount_detour","variants":["Bir saniye, indirim hakkım var mı?"],"off_flow":true,"resume_to":"discount_return",
       "transitions":[{"when":{"assistant_regex":"indirim"},"to":"app_detour"}]},
      {"id":"app_detour","variants":["Bu arada uygulama şifremi de unuttum, nasıl sıfırlarım?"],"off_flow":true,"resume_to":"discount_return",
       "transitions":[{"when":{"assistant_regex":"şifre"},"to":"discount_return"}]},
      {"id":"discount_return","variants":["Tamam, indirim konusuna dönelim: net prim ne oldu?"],"off_flow":true,"resume_to":"renewal_consent",
       "transitions":[{"when":{"assistant_regex":"net prim|4200"},"to":"renewal_consent"}]},
      {"id":"renewal_consent","variants":["PL-90 yenilemesini 4200 TL ile onaylıyorum."],"terminal":true}
    ]},
    "objectives":[
