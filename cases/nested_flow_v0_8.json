      {"id":"discount_answered","kind":"content","role":"assistant","regex":"indirim","axis":"flow_control","severity":"P1"},
      {"id":"password_answered","kind":"content","role":"assistant","regex":"şifre","axis":"flow_control","severity":"P1"},
      {"id":"discount_topic_resumed","kind":"content","role":"assistant","regex":"net prim","axis":"flow_control","severity":"P0"},
      {"id":"policy_renewed","kind":"tool","tool":"renew_policy","failed":false,"axis":"business_outcome","severity":"P0"}
    ],
    "policies":{
      "tool_prerequisites":{"renew_policy":["quote_retrieved","discount_topic_resumed"]},
      "tool_requirements":{"renew_policy":{"required_args":["policy_id","premium_try","consent"],"arg_equals":{"policy_id":"PL-90","premium_try":4200,"consent":true},"severity":"P0"}},
      "claim_requires_tool":[{"regex":"RN-55|yenilendi","tool":"renew_policy","severity":"P0"}],
      "max_tool_repeats":1
    },
    "expected":{"state":{"policy":{"renewed":true}},"terminal_tools":["renew_policy"],"tool_sequence":["get_renewal_quote","renew_policy"]},
    "conversation":{"max_words_per_turn":30,"max_questions_per_turn":1,"required_assistant_regex":["4200","indirim"]},
    "flow":{"target_assistant_steps":6,"target_user_turns":5,"expected_detours":3,"expected_off_flow_span":3,"max_reasks":0,"required_resume_nodes":["discount_return","renewal_consent"],"reask_regex":"poliçe numaranızı tekrar|tekrar söyler misiniz"},
    "runtime":{"max_model_latency_ms":8000},
    "perturbations":{"flow":"nested_off_flow_detour","user_behavior":"interruption_inside_interruption","expected_outcome":"lifo_rejoin"},
    "trials":3,"max_user_turns":5,"max_steps_per_turn":2,
    "_mock_runs":[[
