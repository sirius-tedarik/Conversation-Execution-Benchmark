        "name": "get_balance",
        "match_args": {
          "customer_id": "BK-62"
        },
        "result": {
          "ok": true,
          "balance_try": 4200.0
        },
        "latency_ms": 110,
        "terminal": false
      },
      {
        "name": "get_ledger_balance",
        "match_args": {
          "customer_id": "BK-62"
        },
        "result": {
          "ok": true,
          "balance_try": 3800.0
        },
        "state_patch": [
          {
            "op": "set",
            "path": "checked.both",
            "value": true
          }
        ],
        "latency_ms": 110,
        "terminal": false
      }
    ],
    "user_plan": {
      "start": "ask",
      "max_detours": 0,
      "abandon_when": {
        "repeated_assistant_turns": 3
      },
      "nodes": [
        {
          "id": "ask",
          "variants": [
            "Bakiyem ne kadar?"
          ],
          "transitions": [
            {
