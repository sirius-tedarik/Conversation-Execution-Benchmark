                "assistant_regex": "e-posta|eposta"
              },
              "to": "close"
            }
          ]
        },
        {
          "id": "close",
          "variants": [
            "Teşekkürler."
          ],
          "terminal": true
        }
      ]
    },
    "objectives": [
      {
        "id": "restrict_only_the_named_channel",
        "description": "A ban on one channel must not silently disable the others; the e-mail the customer then asks for has to be sent.",
