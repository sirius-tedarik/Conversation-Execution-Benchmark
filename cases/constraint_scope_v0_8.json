        "Kontrol ediyorum.\n<tool_call>{\"name\":\"send_statement\",\"arguments\":{\"customer_id\":\"BK-60\",\"channel\":\"email\"}}</tool_call>",
        "Ekstrenizi e-posta ile gönderdim.",
        "Rica ederim, iyi günler."
      ]
