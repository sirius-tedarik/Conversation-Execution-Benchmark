[
  {
    "id": "tr_scope_channel_constraint_not_all_channels_001",
    "benchmark_version": "0.8",
    "domain": "scope_channel_over_generalisation",
    "language": "tr-TR",
    "call_direction": "inbound",
    "system": "Sen bir bankacılık müşteri hizmetleri asistanısın. Gelen çağrı. Müşteri: BK-60.\nGörevin: aşağıdaki AKIŞ'ı takip ederek müşteriyle doğal Türkçe konuş.\n\nKULLANILABİLİR ARAÇLAR: send_statement\n\nKURALLAR:\n- Müşterinin koyduğu kısıt SADECE adı geçen kanalı kapsar; diğer kanallar AÇIK kalır.\n\nKIRMIZI ÇİZGİ:\n- Müşteri 'SMS atmayın' dedi. Bu YALNIZCA SMS'i kapsar. Müşteri e-posta isterse REDDETME — e-posta göndermek SERBEST.\n\nAKIŞ (TOON — harfiyen takip et):\nentry_after_greeting:\n  id: ban_sms\n  note: Karşılama zaten yapıldı.\nsteps[3]:\n  - id: ban_sms\n    type: text\n    say_to_customer: \"Anlaşıldı, size SMS göndermeyeceğim.\"\n    internal_guidance: \"Kısıt SADECE SMS'i kapsar. Not et.\"\n    next[1]{id,condition}:\n      ask_email,sonraki adım\n    completion_criteria: Bu adımı tamamlamadan ilerleme.\n  - id: ask_email\n    type: tool\n    tool: send_statement\n    internal_guidance: \"Müşteri e-posta istiyor. Bu kısıtın DIŞINDA — REDDETME, send_statement(channel='email') çağır.\"\n    next[1]{id,condition}:\n      close,sonraki adım\n    completion_criteria: Bu adımı tamamlamadan ilerleme.\n  - id: close\n    type: text\n    say_to_customer: \"Rica ederim, iyi günler.\"\n    internal_guidance: \"Rica ederim, iyi günler.\"\n    completion_criteria: Bu adımı tamamlamadan ilerleme.",
    "available_tools": [
      "send_statement"
    ],
    "tool_schemas": [
      {
        "type": "function",
        "function": {
          "name": "send_statement",
          "description": "Ekstreyi seçilen kanaldan gönder",
          "parameters": {
            "type": "object",
            "properties": {
              "customer_id": {
                "type": "string"
              },
              "channel": {
                "type": "string",
                "enum": [
                  "email",
                  "sms"
                ]
              }
            },
            "required": [
              "customer_id",
              "channel"
            ]
          }
        }
      }
    ],
    "initial_state": {
      "statement": {
        "channel": null
      }
    },
    "tool_contracts": [
      {
        "name": "send_statement",
        "match_args": {
          "customer_id": "BK-60",
          "channel": "email"
        },
        "result": {
          "ok": true,
          "sent": true
        },
        "state_patch": [
          {
            "op": "set",
            "path": "statement.channel",
            "value": "email"
          }
        ],
        "latency_ms": 120,
        "terminal": false
      }
    ],
    "user_plan": {
      "start": "ban_sms",
      "max_detours": 0,
      "abandon_when": {
        "repeated_assistant_turns": 3
      },
      "nodes": [
        {
          "id": "ban_sms",
          "variants": [
            "Bana kesinlikle SMS atmayın."
          ],
          "transitions": [
            {
              "when": {
                "assistant_regex": "SMS.{0,25}(göndermeyeceğim|atmayacağım)"
